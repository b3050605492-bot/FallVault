{
  "identifier": "default",
  "description": "Default permissions for FallVault",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:default",
    "fs:allow-app-write-recursive",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-file",
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-create", "allow": [{ "path": "**" }] },
    "fs:scope-exe-recursive",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "D:/**" },
        { "path": "D:\\**" },
        { "path": "C:/**" },
        { "path": "C:\\**" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$HOME/*" },
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD/*" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/*" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/*" },
        { "path": "$DESKTOP/**" },
        { "path": "$PICTURE/*" },
        { "path": "$PICTURE/**" },
        { "path": "D:/**" },
        { "path": "D:\\**" },
        { "path": "C:/**" },
        { "path": "C:\\**" },
        { "path": "$APPDATA/**" }
      ]
    },
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register-all",
    "global-shortcut:allow-unregister-all",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
